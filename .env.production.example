# =============================================================================
# TEMPLATE .env UNTUK PRODUCTION (Hostinger — portal.allezgroup.com)
# =============================================================================
# JANGAN upload file ini apa adanya. Salin isinya jadi file baru bernama
# ".env" di root project di server, lalu isi baris yang ditandai
# "ISI MANUAL" di bawah. Lihat DEPLOY.md untuk urutan langkah lengkapnya.
# =============================================================================

APP_NAME="Allez Group"

# WAJIB production, bukan local — mengaktifkan optimasi & menyembunyikan
# detail error dari pengunjung.
APP_ENV=production

# WAJIB false di production — kalau true, error PHP/Laravel akan tampil
# lengkap (termasuk isi query DB, path server) ke siapa pun yang mengakses.
APP_DEBUG=false

# ISI MANUAL — generate sendiri, JANGAN pakai APP_KEY dari .env lokal Anda.
# Cara generate: jalankan `php artisan key:generate --show` (butuh PHP CLI
# di komputer Anda atau lewat SSH di server), lalu tempel hasilnya di sini
# persis termasuk awalan "base64:".
APP_KEY=isi_di_sini

# Domain production — WAJIB https (bukan http), tanpa trailing slash.
APP_URL=https://portal.allezgroup.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOG_LEVEL "error" di production (bukan "debug") — supaya log tidak penuh
# noise, cukup catat error yang benar-benar penting.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ISI MANUAL — kredensial database dari hPanel Hostinger (menu Databases).
# JANGAN isi dengan kredensial development lokal Anda.
DB_CONNECTION=mysql
DB_HOST=isi_di_sini
DB_PORT=3306
DB_DATABASE=isi_di_sini
DB_USERNAME=isi_di_sini
DB_PASSWORD=isi_di_sini

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ISI MANUAL (opsional) — kalau notifikasi Telegram (approval GA, dst) mau
# aktif di production. Kosongkan berdua kalau belum mau dipakai — fitur
# terkait akan diam-diam tidak mengirim (tidak error).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ISI MANUAL (SEMENTARA) — HANYA kalau hosting TIDAK ada akses SSH/terminal,
# supaya route darurat /deploy-tasks/{token} bisa dipakai utk menjalankan
# migrate & storage:link lewat browser. Isi dengan string acak yang PANJANG
# (mis. hasil `php artisan key:generate --show` atau random string 40+
# karakter apa saja). WAJIB dikosongkan lagi (baris ini jadi kosong, bukan
# dihapus) setelah selesai dipakai — lihat DEPLOY.md bagian "Setelah Selesai"
# utk cara menonaktifkannya dengan benar (sekadar mengosongkan ini SETELAH
# config:cache pernah jalan tidak langsung cukup).
DEPLOY_TOKEN=
